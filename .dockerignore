# .dockerignore - Optimized for faster builds

# Git
.git
.gitignore
.gitattributes

# Documentation
README.md
*.md
docs/

# CI/CD
.github/
.gitlab-ci.yml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies (will be installed during build)
node_modules/
**/node_modules

# Build artifacts
dist/
build/
.next/
.nuxt/

# Cache
.cache/
.parcel-cache/
.npm/
.yarn/cache/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Docker
docker-compose*.yml
Dockerfile*
!Dockerfile.build

# Testing
coverage/
.nyc_output/
test-results/

# Temporary files
tmp/
temp/
*.tmp 
